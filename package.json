{
    "name": "@khanacademy/design-guidelines",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@10.1.0",
    "engines": {
        "node": ">=24.13 <25"
    },
    "scripts": {
        "start": "storybook dev -p 56789",
        "build": "pnpm design-md && storybook build --stats-json",
        "design-md": "node scripts/design-md/generate.ts",
        "lint:design-md": "design.md lint design-md/DESIGN.md",
        "test": "node --test \"scripts/**/*.test.ts\"",
        "typecheck": "tsc --noEmit && tsc -p scripts/design-md"
    },
    "dependencies": {
        "@khanacademy/wonder-blocks-announcer": "^1.1.2",
        "@khanacademy/wonder-blocks-badge": "^1.1.26",
        "@khanacademy/wonder-blocks-banner": "^5.1.16",
        "@khanacademy/wonder-blocks-button": "^11.7.12",
        "@khanacademy/wonder-blocks-clickable": "^8.3.1",
        "@khanacademy/wonder-blocks-core": "^12.5.0",
        "@khanacademy/wonder-blocks-dropdown": "^10.13.0",
        "@khanacademy/wonder-blocks-icon": "^6.0.2",
        "@khanacademy/wonder-blocks-icon-button": "^12.0.1",
        "@khanacademy/wonder-blocks-link": "^10.4.1",
        "@khanacademy/wonder-blocks-theming": "^4.1.0",
        "@khanacademy/wonder-blocks-tokens": "^18.0.0",
        "@khanacademy/wonder-blocks-typography": "^5.0.5",
        "@phosphor-icons/core": "^2.0.2",
        "aphrodite": "^1.2.5",
        "react": "18.2.0",
        "react-dom": "18.2.0",
        "react-router": "5.3.4",
        "react-router-dom": "5.3.4",
        "react-router-dom-v5-compat": "^6.30.0"
    },
    "devDependencies": {
        "@google/design.md": "0.4.0",
        "@storybook/addon-a11y": "10.3.5",
        "@storybook/addon-docs": "10.3.5",
        "@storybook/addon-mcp": "^0.6.0",
        "@storybook/react-vite": "10.3.5",
        "@types/node": "^24.19.1",
        "@types/react": "^18.2.0",
        "@types/react-dom": "^18.2.0",
        "chromatic": "^18.0.1",
        "remark-gfm": "^4.0.0",
        "storybook": "10.3.5",
        "storybook-addon-tag-badges": "^3.1.0",
        "typescript": "5.7.3",
        "vite": "^6.0.11",
        "yaml": "^2.9.1"
    }
